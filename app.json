{
  "expo": {
    "name": "Queless Driver",
    "slug": "queless-driver",
    "version": "1.0.1",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "com.queless.driver",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E1F23"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.queless.driver"
    },
    "android": {
      "package": "com.queless.driver",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1E1F23",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "locationWhenInUsePermission": "Queless Driver uses your location to find nearby orders and show your live location during deliveries.",
          "locationAlwaysAndWhenInUsePermission": "While you are online, Queless Driver uses your location in the background so nearby delivery offers can reach you.",
          "locationAlwaysPermission": "While you are online, Queless Driver uses your location in the background so nearby delivery offers can reach you."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#D13540"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Queless Driver uses the camera to add your profile photo.",
          "photosPermission": "Queless Driver uses your photos to add a profile picture."
        }
      ],
      "expo-background-task",
      "expo-task-manager",
      "expo-font",
      "expo-secure-store",
      [
        "expo-status-bar",
        {
          "hidden": true
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "enforceContrast": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "source-code-development",
          "project": "queless-driver-mobile"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6150ba97-2eec-4dca-a848-35880ba12523"
      }
    },
    "owner": "salmonphapangs-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6150ba97-2eec-4dca-a848-35880ba12523"
    }
  }
}
