{
  "expo": {
    "name": "Queless Driver",
    "slug": "queless-driver-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "system",
    "scheme": "com.queless.driver",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E1F23"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.queless.driver"
    },
    "android": {
      "package": "com.queless.driver",
      "adaptiveIcon": {
        "backgroundColor": "#1E1F23",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#D13540"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Queless Driver uses the camera to add your profile photo.",
          "photosPermission": "Queless Driver uses your photos to add a profile picture."
        }
      ],
      "expo-background-task",
      "expo-task-manager",
      "expo-font",
      "expo-secure-store",
      [
        "expo-status-bar",
        {
          "hidden": true
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "enforceContrast": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "source-code-development",
          "project": "queless-driver-mobile"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ccc4dfcb-0bbc-4d1e-8ae4-a69572cddf88"
      }
    },
    "owner": "developers_sourcecodes"
  }
}
