# Public configuration only. Never put Paystack secret keys or Sentry auth tokens here.
EXPO_PUBLIC_APP_ENV=dev
EXPO_PUBLIC_SUPABASE_URL=https://lxsvydiyzeavdqbjxkpp.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional public build metadata. Native build numbers normally come from app.json.
# EXPO_PUBLIC_APP_VERSION=1.0.1
# EXPO_PUBLIC_APP_BUILD_NUMBER=1

# Development-only device-binding override. Release builds ignore this.
# EXPO_PUBLIC_ENABLE_DEVICE_BINDING=true

# Public Paystack subaccount percentage charge (0 for driver payouts).
EXPO_PUBLIC_PAYSTACK_SUBACCOUNT_PERCENTAGE_CHARGE=0
