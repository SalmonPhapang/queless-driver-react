# ---- Supabase (required) -------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Environment ---------------------------------------------------------
# dev | stage | prod
VITE_APP_ENV=dev

# ---- Feature flags -------------------------------------------------------
# Optional local override for the server-authoritative device-binding policy.
# Only honoured in dev builds; leave blank to follow app_settings.
VITE_ENABLE_DEVICE_BINDING=

# Paystack subaccount split retained by Queless (percentage, 0-100).
VITE_PAYSTACK_SUBACCOUNT_PERCENTAGE_CHARGE=0

# ---- Version (used by app_versions update checks) ------------------------
VITE_APP_VERSION=1.0.1
VITE_APP_BUILD_NUMBER=1
